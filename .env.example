# Copy to .env and fill in. .env is git-ignored; never commit real values.

# --- API service ---
API_HOST=0.0.0.0
API_PORT=3000
LOG_LEVEL=info

# --- Local LLM runtime (Phase 2) ---
# llama.cpp OpenAI-compatible server base URL
LLAMA_CPP_BASE_URL=http://localhost:8080/v1

# --- Speech stack (Phase 4+) ---
# Speaches OpenAI-compatible speech API base URL
SPEACHES_BASE_URL=http://localhost:8000

# --- Premium TTS (Phase 14, optional) ---
ELEVENLABS_API_KEY=
